# Copiar a .env.local para desarrollo. En EasyPanel se cargan en la pestaña
# "Entorno" del servicio.

# Base de datos donde se guardan las respuestas. En producción DB_HOST es el
# host interno de la base del dashboard (dashboard_database).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=supricom_panel

# Odoo, para la lista de vendedores (P3). Mismos valores que usa el dashboard:
# ODOO_URL es su NEXT_PUBLIC_ODOO_URL. ODOO_UID es opcional (por defecto 388).
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
